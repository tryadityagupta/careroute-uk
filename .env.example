# ---------------------------------------------------------------------------
# UK CareRoute settings. Every variable CareRoute reads is in
# careroute/config.py; nothing else reads the environment.
# Keep comments on their own lines: python-dotenv reads `KEY=   # note` as
# the literal value "# note".
# ---------------------------------------------------------------------------

# --- Model -----------------------------------------------------------------
# Empty key + unset CAREROUTE_LLM = offline mode: deterministic rules and a
# scripted route model. The whole demo works with no key and no network.
OPENAI_API_KEY=
# openai | offline (default: openai when OPENAI_API_KEY is set, else offline)
# CAREROUTE_LLM=offline
# CAREROUTE_OPENAI_MODEL=gpt-4o-mini
# CAREROUTE_EXTRACTION_MODEL=gpt-4o-mini
# CAREROUTE_ROUTE_MAX_LLM_CALLS=6
CAREROUTE_LLM_TIMEOUT_S=30
CAREROUTE_LLM_MAX_RETRIES=2

# --- Identity: NHS login ---------------------------------------------------
# demo = pick a fictional patient in the page (X-Demo-User header).
# oidc = verify NHS login ID tokens (sandpit / integration / live).
NHS_LOGIN_MODE=demo
# NHS_LOGIN_ISSUER=https://auth.sandpit.signin.nhs.uk
# NHS_LOGIN_CLIENT_ID=

# --- Demo and integrations -------------------------------------------------
# /demo/* routes (user picker, fault switch, SMS outbox, simulated referrals).
# Set to 0 anywhere real people could reach.
CAREROUTE_DEMO_TOOLS=1
# Shared secret the e-RS side sends as X-Event-Key on POST /referrals/events.
# Empty = only allowed while CAREROUTE_DEMO_TOOLS=1.
CAREROUTE_REFERRAL_EVENT_KEY=
# Used in consent links sent to friends: <base>/consent/<token>
CAREROUTE_PUBLIC_BASE_URL=http://localhost:8000
# Postcode lookups (demo postcodes also resolve offline).
# POSTCODES_IO_URL=https://api.postcodes.io
# CAREROUTE_UK_GEOCODE_NETWORK=1
# SMS: empty = demo outbox (shown in the page). The Notify template must use
# ((first_name)), ((when)) and ((reference)) and nothing clinical.
GOVUK_NOTIFY_API_KEY=
GOVUK_NOTIFY_SMS_TEMPLATE_ID=

# --- Places and routing ----------------------------------------------------
CAREROUTE_GEOCODE_COUNTRIES=gb
# Provider directory: demo | nhs | mixed | auto. auto = mixed when
# data/uk/nhs/directory.json exists (scripts/import_nhs_directory.py), else demo.
CAREROUTE_UK_DIRECTORY=auto
# docker-compose.yml sets these for you; set them yourself only when running
# uvicorn outside Compose against a local map stack.
# OSRM_BASE_URL=http://localhost:5000
# NOMINATIM_URL=http://localhost:8080

# --- Legacy single-agent CareRoute (/legacy) -------------------------------
# "" = 10 dummy providers offline | osm | google
USE_REAL_PROVIDERS=
GOOGLE_MAPS_API_KEY=
OSM_SOURCE=overpass
# GEO_DATABASE_URL=            # defaults to DATABASE_URL

# --- Abuse protection ------------------------------------------------------
CAREROUTE_RATE_PER_MIN=20
CAREROUTE_BURST=5
CAREROUTE_API_KEYS=
CAREROUTE_DAILY_CALL_CAP=0
CAREROUTE_ALLOWED_ORIGINS=*
CAREROUTE_TRUST_XFF=1

# --- Shared state (stateless replicas) -------------------------------------
CAREROUTE_REQUIRE_SHARED_STATE=0
CAREROUTE_SESSION_TTL=1800
CAREROUTE_PG_AUTO_MIGRATE=1
# REDIS_URL=
# DATABASE_URL=
# CAREROUTE_KEY_PREFIX=careroute
# CAREROUTE_REDIS_TIMEOUT_S=1.0
# CAREROUTE_PG_POOL_MAX=10
# GEO_POOL_MAX=10
# GEO_STATEMENT_TIMEOUT_MS=2000
# OSRM_TIMEOUT_S=3
# CAREROUTE_MAX_LLM_CALLS=8
# CAREROUTE_MAX_SESSIONS=5000
# CAREROUTE_TURN_LOCK_S=180

# --- Logging ---------------------------------------------------------------
# CAREROUTE_LOG_PII=0
# CAREROUTE_LOG_COORD_DP=2
# CAREROUTE_LOG_FILE=
# BLOB_ACCOUNT_URL=
# BLOB_CONTAINER=patient-data
# DATA_DIR=./data
# GIT_SHA=local-dev
